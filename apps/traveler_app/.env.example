# Lakbay+ Travel Planner Environment Template
# Copy to .env and fill in your API keys.

# Mapbox (Public pk.eyJ1... token for map tiles & static route images)
MAPBOX_ACCESS_TOKEN=

# Primary AI: Groq (OpenAI-compatible endpoint, from Lakbay monorepo)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_DEFAULT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.30
GROQ_MAX_TOKENS=4096

# Fallback AI: Google Gemini (OpenAI-compatible endpoint) or other OpenAI-compatible LLM
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cloudinary Media Storage (from Lakbay monorepo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional OpenWeather API Key
OPENWEATHER_API_KEY=

# Optional Lakbay+ FastAPI Backend & Google Sign-In
LAKBAY_API_BASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
