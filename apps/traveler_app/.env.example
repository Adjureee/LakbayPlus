# Lakbay+ Travel Planner Environment Template
# Copy to .env and fill in your API keys.

# Mapbox (Public pk.eyJ1... token for map tiles & static route images)
MAPBOX_ACCESS_TOKEN=

# AI chat and trip drafts run on the Lakbay backend (services/api).
# Do NOT add GROQ_API_KEY or FALLBACK_LLM_API_KEY here: this file is
# bundled into the app, so any key in it can be extracted from the APK.

# Cloudinary Media Storage (from Lakbay monorepo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Optional OpenWeather API Key
OPENWEATHER_API_KEY=

# Optional Lakbay+ FastAPI Backend & Google Sign-In
LAKBAY_API_BASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
